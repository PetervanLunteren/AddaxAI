{
  "name": "addaxai-desktop",
  "version": "0.0.0-dev",
  "description": "AddaxAI - Camera trap wildlife analysis platform",
  "main": "dist/main.js",
  "homepage": "https://github.com/PetervanLunteren/AddaxAI-WebUI",
  "author": {
    "name": "Addax Data Science",
    "email": "peter@addaxdatascience.com"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "tsc && electron .",
    "build": "tsc",
    "start": "electron .",
    "package": "electron-builder"
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "@electron/notarize": "^2.2.1",
    "@types/node": "^20.10.0",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.3.3"
  },
  "build": {
    "appId": "com.addaxai.cameratrap",
    "productName": "AddaxAI",
    "directories": {
      "output": "dist-build"
    },
    "publish": null,
    "generateUpdatesFilesForAllChannels": false,
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/backend",
        "to": "backend"
      }
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": ["dmg"],
      "artifactName": "${productName}-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false
    },
    "afterSign": "build/notarize.js",
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": ["nsis"],
      "artifactName": "${productName}-Setup.${ext}",
      "signtoolOptions": {
        "publisherName": "Addax Data Science",
        "signingHashAlgorithms": ["sha256"],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    },
    "linux": {
      "target": ["deb"],
      "icon": "build/icons",
      "artifactName": "${productName}-${arch}.${ext}",
      "category": "Science",
      "maintainer": "Addax Data Science <peter@addaxdatascience.com>"
    },
    "deb": {
      "packageName": "addaxai",
      "afterInstall": "build/deb-after-install.sh",
      "fpm": [
        "--replaces",
        "addaxai-desktop",
        "--conflicts",
        "addaxai-desktop",
        "build/addaxai.metainfo.xml=/usr/share/metainfo/com.addaxai.cameratrap.metainfo.xml"
      ]
    }
  }
}
