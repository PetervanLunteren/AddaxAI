# Windows env-tensorflow-v2.
#
# Mirrors the legacy AddaxAI Windows build workflow's env-tensorflow-v2
# package list (build-windows-release.yml:274-291). Pinned to TF 2.16.2
# to match darwin and Linux for reproducibility.
#
# Note on GPU: native Windows TF support stopped at TF 2.10 — TF 2.16
# on Windows is CPU-only (or via WSL2). For Windows GPU TF you'd want
# tensorflow-v1 or run the Linux build under WSL2.
name: env-tensorflow-v2
channels:
  - conda-forge
dependencies:
  - python=3.11
  - pip
  - pip:
      - tensorflow==2.16.2
      - huggingface_hub==0.23.0
      - jax==0.4.28
      - jaxlib==0.4.28
      - keras==3.3.3
      - keras_cv==0.9.0
      - kimm==0.2.5
      - matplotlib==3.9.0
      - numpy==1.26.4
      - pandas==2.2.2
      - pytest==8.3.0
      - pyyaml==6.0.1
      - scikit-learn==1.4.2
      - tqdm==4.66.4
      - jsonpickle==4.0.1
      - opencv-python==4.11.0.86
      - pip-system-certs
