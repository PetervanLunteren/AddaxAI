# Linux env-pytorch.
#
# Same package set as darwin/pytorch/environment.yml (the curated
# WebUI baseline). Linux gets cu118 wheels for torch + torchvision so
# pytorch-based classifiers run on GPU.
name: env-pytorch
channels:
  - conda-forge
dependencies:
  - python=3.8
  - pip
  - pip:
      - --extra-index-url https://download.pytorch.org/whl/cu118
      - torch==2.0.1
      - torchvision==0.15.2
      - ultralytics==8.0.191
      - numpy==1.24.1
      - humanfriendly==10.0
      - jsonpickle==3.0.2
      - timm
      - dill
      - omegaconf
      - pytorch-lightning==2.0.6
      - albumentations==1.3.1
