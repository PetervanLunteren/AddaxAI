name: env-addaxai-base
channels:
  - conda-forge
  - defaults
dependencies:
  - python=3.11
  - pip
  - pip:
    # CUDA torch wheels installed first so megadetector's transitive
    # torch requirement is satisfied by the GPU build instead of pip
    # falling back to the CPU wheel from PyPI.
    - --extra-index-url https://download.pytorch.org/whl/cu118
    - torch==2.3.0
    - torchvision==0.18.0

    # Image processing and metadata
    - exifread
    - piexif
    - gpsphoto
    - hachoir

    # Utility packages
    - appdirs
    - requests
    - pillow
    - tqdm
    - huggingface_hub
    - anyio<4.0  # Pin to v3.x for Python 3.11 typing compatibility
    - openpyxl

    # Similarity search
    - faiss-cpu>=1.7.4

    # MegaDetector and detection packages
    - setuptools<82  # yolov5 needs pkg_resources, removed in setuptools 82
    - megadetector==10.0.18
    - ultralytics==8.3.177
